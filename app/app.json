{
  "expo": {
    "name": "Mermaid Spells",
    "slug": "mermaid-spells",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E2C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mermaidspells.app",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E2C"
      },
      "package": "com.mermaidspells.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Mermaid Spells to listen while your child practices letter sounds.",
          "speechRecognitionPermission": "Allow Mermaid Spells to check spoken letter sounds.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-av",
      "expo-font"
    ]
  }
}
